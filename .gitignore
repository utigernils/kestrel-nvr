# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Web UI
web/node_modules/
web/dist/
# The built UI in app/web is committed on purpose: the Docker build can use it
# when the npm registry is not reachable (WEB_MODE=pre).

# Local data and configuration - never commit these
/config/
/data/
config.yml
*.db
*.db-wal
*.db-shm
install.env

# Detection models downloaded at runtime
/models/*.onnx
!/models/yolox_tiny.onnx
# Bundled YOLO26 models (AGPL-3.0, see models/README.md) - remove these two lines to keep them out of the repo
!/models/yolo26n.onnx
!/models/yolo26s.onnx

# Packaging and editors
*.zip
.DS_Store
.idea/
.vscode/
